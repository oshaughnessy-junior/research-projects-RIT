# Optional terminal evidence jobs. This capability is deliberately opt-in:
# the long-standing hyperpipe default, util_ConstructEOSPosterior.py, writes a
# scalar integral rather than the paired CIP annotation records consumed by
# util_CIPDirSummarizeEvidence.py. The pseudo-pipe Hyperpipe route uses the
# GenericCoordinates CIP executable and explicitly enables this contract.
terminal_prior_job = None
terminal_evidence_job = None
if opts.terminal_evidence:
    terminal_prior_args = (
        eos_post_args_per_iteration[-1]
        + " --integrate-prior --n-output-samples 1 --no-plots "
    )
    terminal_prior_job, _ = dag_utils.write_hyperpost_sub(
        exe=eospost_exe, tag="EOS_POST_prior",
        arg_str=terminal_prior_args, out_dir=opts.working_directory,
        output="prior-integral-$(macroiteration)",
        input_net=opts.working_directory + "/all.marg_net",
        request_memory=opts.request_memory_marg,
        request_disk=opts.general_request_disk,
        universe=local_worker_universe, no_grid=no_worker_grid)
    terminal_prior_job.add_condor_cmd("initialdir", opts.working_directory)
    terminal_prior_job.set_log_file(opts.working_directory+"/iteration_$(macroiteration)_con/logs/prior-$(cluster)-$(process).log")
    terminal_prior_job.set_stderr_file(opts.working_directory+"/iteration_$(macroiteration)_con/logs/prior-$(cluster)-$(process).err")
    terminal_prior_job.set_stdout_file(opts.working_directory+"/iteration_$(macroiteration)_con/logs/prior-$(cluster)-$(process).out")
    if opts.use_full_submit_paths:
        terminal_prior_job.set_sub_file(
            opts.working_directory + "/" + terminal_prior_job.get_sub_file())
    terminal_prior_job.write_sub_file()

    evidence_exe = dag_utils.which("util_CIPDirSummarizeEvidence.py") or "util_CIPDirSummarizeEvidence.py"
    terminal_evidence_args = (
        " --cip-dir {wd}"
        " --annotation-glob {wd}/iteration_$(macroiteration)_post/"
        "output-$(macroiterationnext)-*+annotation.dat"
        " --output {wd}/evidence_$(macroiteration) --strict"
        " --prior-integral {wd}/prior-integral-$(macroiteration)_withpriorchange+annotation.dat"
        " --normalized-output {wd}/evidence_$(macroiteration)_normalized "
    ).format(wd=opts.working_directory)
    terminal_evidence_job, _ = dag_utils.write_convert_sub(
        tag="evidence_final", exe=evidence_exe, log_dir=None,
        file_input="", arg_str=terminal_evidence_args,
        out_dir=opts.working_directory, universe=local_worker_universe,
        no_grid=no_worker_grid)
    terminal_evidence_job.add_condor_cmd("initialdir", opts.working_directory)
    terminal_evidence_job.set_log_file(opts.working_directory+"/iteration_$(macroiteration)_con/logs/evidence-final-$(cluster)-$(process).log")
    terminal_evidence_job.set_stderr_file(opts.working_directory+"/iteration_$(macroiteration)_con/logs/evidence-final-$(cluster)-$(process).err")
    terminal_evidence_job.set_stdout_file(opts.working_directory+"/iteration_$(macroiteration)_con/logs/evidence-final-$(cluster)-$(process).out")
    terminal_evidence_job.add_condor_cmd("request_disk", opts.general_request_disk)
    if opts.use_full_submit_paths:
        terminal_evidence_job.set_sub_file(
            opts.working_directory + "/" + terminal_evidence_job.get_sub_file())
    terminal_evidence_job.write_sub_file()


# Generic terminal jobs. The manifest owns the executable protocols and
# dependency names; this writer only supplies the final-iteration macros and
# the reserved ``pipeline`` parent when it materializes DAG nodes below.
terminal_stage_jobs = {}
for terminal_stage in terminal_stage_specs:
    mkdir(terminal_stage.initial_dir)
    mkdir(terminal_stage.log_dir)
    if terminal_stage.kind == INDEXED_GRID_FANOUT_V1:
        execution = terminal_stage.job.execution
        use_osg_here = bool(execution.get("use_osg", opts.use_osg))
        use_singularity_here = bool(
            execution.get("use_singularity", opts.use_singularity))
        singularity_image_here = execution.get("singularity_image") or singularity_image
        transfer_here = list(dict.fromkeys(
            list(transfer_file_names) + list(
                execution.get("transfer_files", []))))
        grid_arg = terminal_stage.grid
        if use_osg_here or use_singularity_here:
            transfer_here.append(terminal_stage.grid)
            grid_arg = os.path.basename(terminal_stage.grid)
        terminal_args = terminal_stage.job.args
        if terminal_stage.args_append:
            terminal_args += " " + terminal_stage.args_append
        terminal_args += " --sim-grid " + grid_arg
        if max(terminal_stage.group_sizes) > 1:
            terminal_args += " --n-events-to-analyze $(macrongroup)"
        terminal_job, _ = dag_utils.write_ILE_sub_simple(
            tag="TERMINAL_" + terminal_stage.name,
            log_dir=None, exe=terminal_stage.job.exe,
            arg_str=terminal_args, output_file=terminal_stage.output_file,
            simple_unique=True,
            ncopies=int(execution.get("copies", 1)),
            request_memory=int(execution.get(
                "request_memory", opts.request_memory_marg)),
            request_disk=execution.get(
                "request_disk", opts.general_request_disk),
            request_gpu=bool(execution.get("request_gpu", False)),
            request_cross_platform=bool(
                execution.get("request_cross_platform", False)),
            use_singularity=use_singularity_here,
            singularity_image=singularity_image_here,
            use_osg=use_osg_here,
            use_simple_osg_requirements=bool(execution.get(
                "use_simple_osg_requirements", use_osg_here)),
            use_cvmfs_frames=bool(
                execution.get("use_cvmfs_frames", False)),
            use_oauth_files=execution.get("use_oauth_files", False),
            frames_dir=execution.get("frames_dir"),
            cache_file=execution.get("cache_file"),
            transfer_files=transfer_here,
            transfer_output_files=execution.get("transfer_output_files"),
            max_runtime_minutes=execution.get("max_runtime_minutes"),
            condor_commands=execution.get("condor_commands"),
        )
    elif terminal_stage.kind == COMMAND_V1:
        command_execution = terminal_stage.execution
        terminal_job, _ = dag_utils.write_command_sub(
            tag="TERMINAL_" + terminal_stage.name,
            exe=terminal_stage.exe, log_dir=None,
            arg_str=terminal_stage.args,
            universe=terminal_stage.universe,
            no_grid=terminal_stage.no_grid,
            use_osg=bool(command_execution.get("use_osg", False)),
            use_singularity=bool(
                command_execution.get("use_singularity", False)),
            singularity_image=command_execution.get("singularity_image"),
            use_simple_osg_requirements=bool(
                command_execution.get("use_simple_osg_requirements", False)),
            transfer_files=command_execution.get("transfer_files"),
            transfer_output_files=command_execution.get(
                "transfer_output_files"),
            max_runtime_minutes=terminal_stage.execution_value(
                "max_runtime_minutes", 120))
        request_memory = terminal_stage.execution_value("request_memory")
        if request_memory is not None:
            terminal_job.add_condor_cmd("request_memory", str(request_memory))
        request_disk = terminal_stage.execution_value(
            "request_disk", opts.general_request_disk)
        if request_disk is not None:
            terminal_job.add_condor_cmd("request_disk", str(request_disk))
    else:
        raise ValueError("unhandled terminal stage kind {}".format(
            terminal_stage.kind))

    terminal_job.add_condor_cmd("initialdir", terminal_stage.initial_dir)
    terminal_job.set_log_file(
        terminal_stage.log_dir + "/{}-$(cluster)-$(process).log".format(
            terminal_stage.name))
    terminal_job.set_stderr_file(
        terminal_stage.log_dir + "/{}-$(cluster)-$(process).err".format(
            terminal_stage.name))
    terminal_job.set_stdout_file(
        terminal_stage.log_dir + "/{}-$(cluster)-$(process).out".format(
            terminal_stage.name))
    for key, value in terminal_stage.execution_value(
            "condor_commands", {}).items():
        terminal_job.add_condor_cmd(str(key), str(value))
    if opts.use_full_submit_paths:
        terminal_job.set_sub_file(
            opts.working_directory + "/" + terminal_job.get_sub_file())
    terminal_job.write_sub_file()
    terminal_stage_jobs[terminal_stage.name] = terminal_job


# worker join job
with open("join_post.sh",'w') as f:
    f.write("""#!/bin/bash
set -euo pipefail
input_dir=$1
output_file=$2
output_tmp="${output_file}.tmp.$$"
trap 'rm -f "$output_tmp"' EXIT
awk '/^#/ {print; next} {exit}' grid-0.dat > "$output_tmp"
shuffle=$(command -v shuf || command -v gshuf)
if [ -z "$shuffle" ]; then
    echo "join_post.sh requires shuf or gshuf" >&2
    exit 1
fi
shopt -s nullglob
sample_files=()
for sample_file in "$input_dir"/output-*.dat; do
    sample_name=$(basename "$sample_file")
    case "$sample_name" in
        *+*|*_*) continue ;;
    esac
    sample_files+=("$sample_file")
done
if [ "${#sample_files[@]}" -eq 0 ]; then
    echo "join_post.sh found no primary posterior sample files in $input_dir" >&2
    exit 2
fi
for sample_file in "${sample_files[@]}"; do
    grep -v '^#' "$sample_file"
done | sort -r | uniq | "$shuffle" >> "$output_tmp"
if ! awk '!/^#/ && NF {found=1} END {exit found ? 0 : 1}' "$output_tmp"; then
    echo "join_post.sh found no posterior sample rows in $input_dir" >&2
    exit 3
fi
mv "$output_tmp" "$output_file"
trap - EXIT
""")
    os.system("chmod a+x join_post.sh")
# In tracer mode the tracer node owns grid-{k+1}.dat; EOS_POST output goes to a
# parallel posterior-{k+1}.dat file (diagnostic only). In legacy mode EOS_POST
# still produces grid-{k+1}.dat directly.
_join_post_output_path = opts.working_directory + (
    "/posterior-$(macroiterationnext).dat" if puff_uses_marg_net
    else "/grid-$(macroiterationnext).dat")
