if puff_args and puff_cadence:
    # Resolve --puff-exe to a full path matching how eospost_exe is handled
    # above: bare names (e.g. "util_HyperparameterTracerUpdate.py") get
    # resolved via `which`; if the user already passed an absolute path,
    # leave it alone. Condor on some test machines does not search PATH
