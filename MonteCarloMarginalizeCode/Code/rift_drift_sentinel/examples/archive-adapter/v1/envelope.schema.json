{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rift:archive-snapshot-draft:v0",
  "title": "Experimental backend-neutral archive snapshot vocabulary v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["vocabulary_version", "producer", "archive", "simulations"],
  "properties": {
    "vocabulary_version": {"const": "archive.snapshot-draft/v0"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "implementation_version", "backend"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "minLength": 1},
        "backend": {"type": "object"}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "provenance": {"type": "object"}
      }
    },
    "simulations": {
      "type": "array",
      "items": {"$ref": "#/$defs/simulation"}
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "normalized": {
          "enum": ["requested", "ready", "running", "complete", "failed", "unknown"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "media_type", "handle"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "handle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "opaque"},
            "value": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"}
          }
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fidelity", "state", "artifacts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fidelity": {},
        "state": {"$ref": "#/$defs/state"},
        "summary": {},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameters", "state", "levels", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "native_id": {"type": ["string", "null"]},
        "parameters": {},
        "state": {"$ref": "#/$defs/state"},
        "levels": {"type": "array", "items": {"$ref": "#/$defs/level"}},
        "provenance": {"type": "object"}
      }
    }
  }
}
