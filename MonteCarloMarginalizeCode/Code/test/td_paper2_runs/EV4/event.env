# EV-4 = GW230731_215307 -- paper-2 WEAK / non-obvious O4a glitch case (config U/MF/MP).
# Chosen from GWTC-4.0 DQ Table 8 (arXiv:2508.18082, App. B): mitigation was ONLY an f_low raise
# 20 -> 40 Hz in H1 alone (NO BayesWave subtraction) -- the collaboration judged the glitch
# sub-dominant.  Single-detector, band-restriction-only mitigation = exactly the "glitch present
# but not dominant" robustness objective the paper targets.  Open O4a strain confirmed on GWOSC
# (both H1 and L1).  netSNR 12.2; detector-frame Mc~9.5, Mtot~22.3, eta~0.24 (m1~13.4, m2~8.9).
#
# RESIDUAL UNCERTAINTY (flagged): Table 8 gives NO Gravity Spy class and NO explicit TF window for
# f_low-raise rows -- only the cutoff.  The 20-40 Hz near-trigger H1 footprint is CONSISTENT WITH
# low-frequency scattering / low-freq blip but is UNCONFIRMED.  The glitch time/window below is
# INFERRED (trigger GPS + the 20-40 Hz cutoff band).  The Gravity Spy O4 catalog is NOT in Zenodo
# 5649212 (O1-O3 only), so the H1 corpus uses an O3b Scattered_Light morphology proxy -- documented
# approximation.  Even-more-modest alternatives: GW230803_033412 (f_low 30, H1) / GW230601_224134
# (f_low 20.93, H+L, near-trivial).

TAG=GW230731
GPS=1374875605.9
IFOS=H1,L1
SRATE=2048
ILE_SEGLEN=16                    # low total mass (~22 Msun) -> longer inspiral: 16 s segment
FRAME_SEGLEN=32
FMIN=20                          # do NOT raise f_low to 40: the demo IS marginalizing instead
FMAX=1000
FREF=20
APPROX=IMRPhenomXPHM
LMAX=4
DMAX=10000
ASSUME_NOSPIN=False
DATA_TUKEY_WINDOW_TIME=0.4
M1_DET=13.4
M2_DET=8.9
NET_SNR=12.2

# ---- glitch basis: H1 (the only mitigated detector); low-freq, inferred scattering-like ----
GLITCH_IFO=H1
GLITCH_CLASS=Scattered_Light     # INFERRED (no GS class published); proxy corpus, see caveat above
GLITCH_CENTER_GPS=1374875605.9   # at the trigger (no precise glitch GPS published)
GLITCH_FLO=20
GLITCH_FHI=40                    # the f_low-raise band 20-40 Hz
GLITCH_NOUT=8192                 # 4 s strain support
GLITCH_PCA_NWIN=2048

# corpus: H1 O3b Scattered_Light morphology proxy (O4 Gravity Spy not in Zenodo 5649212).
CORPUS_REUSE_CORPUS=
CORPUS_REUSE_PCA=
CORPUS_CATALOG=H1_O3b.csv        # zenodo.org/records/5649212/files/H1_O3b.csv?download=1
CORPUS_NTARGET=60
CORPUS_WINDOW_HALF=1.5
CORPUS_SNR_LO=8
CORPUS_SNR_HI=100
CORPUS_PEAKF_LO=10
CORPUS_PEAKF_HI=45
CORPUS_DURATION_MAX=6
CORPUS_MINPERWIN=5

# ---- D config: NOT available (O4a; no public deglitched frames -- f_low raise only). ----
DEGLITCH_CACHE=
