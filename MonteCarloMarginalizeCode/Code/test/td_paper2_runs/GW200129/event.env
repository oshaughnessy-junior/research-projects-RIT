# GW200129_065458 -- paper-2 real-data glitch-marg demonstration (config U/MF/MP/D).
# Dossier (Payne et al. arXiv:2206.11932; GWTC-3): a loud SCATTERED-LIGHT glitch in L1 ~20-50 Hz
# in the ~0.5 s before merger, overlapping the signal.  The precession claim (Hannam et al. 2022)
# depends on how the glitch is subtracted -> the "subtraction schools" head-to-head.  Public
# BayesWave-deglitched frames exist (Zenodo 5546679 + Payne Zenodo 7259655) -> D config.
#
# Detector-frame masses from source-frame x (1+z), z~=0.18: Mc~32.1, Mtot~74.7, eta~0.24
# (m1~44.8, m2~29.9 detector frame; fiducial coinc point only).  netSNR ~26.8.

TAG=GW200129
GPS=1264316116.4
IFOS=H1,L1
SRATE=2048
ILE_SEGLEN=8
FRAME_SEGLEN=16
FMIN=20
FMAX=1000
FREF=20
APPROX=IMRPhenomXPHM
LMAX=4
DMAX=10000
ASSUME_NOSPIN=False
DATA_TUKEY_WINDOW_TIME=0.4
M1_DET=44.8
M2_DET=29.9
NET_SNR=26.8

# ---- glitch basis: SCATTERED_LIGHT (long arch), L1, ~0.5 s pre-merger ----
GLITCH_IFO=L1
GLITCH_CLASS=Scattered_Light
GLITCH_CENTER_GPS=1264316116.0   # ~0.4 s pre-merger (glitch overlaps late inspiral)
GLITCH_FLO=15
GLITCH_FHI=55
GLITCH_NOUT=8192                 # 4 s strain support
GLITCH_PCA_NWIN=2048            # 1 s central PCA window

# corpus: fetch fresh Scattered_Light from Gravity Spy L1 O3b (GW200129 is O3b; Zenodo 5649212).
CORPUS_REUSE_CORPUS=
CORPUS_REUSE_PCA=
CORPUS_CATALOG=L1_O3b.csv        # zenodo.org/records/5649212/files/L1_O3b.csv?download=1
CORPUS_NTARGET=60
CORPUS_WINDOW_HALF=1.5
CORPUS_SNR_LO=8
CORPUS_SNR_HI=100
CORPUS_PEAKF_LO=10
CORPUS_PEAKF_HI=55
CORPUS_DURATION_MAX=6
CORPUS_MINPERWIN=5

# ---- D config: PUBLIC BayesWave-deglitched frames ----
DEGLITCH_SOURCE=Zenodo 5546679 / Payne Zenodo 7259655 (GW200129 BayesWave-subtracted)
DEGLITCH_CACHE=                  # set to the local file:// cache of the downloaded deglitched L1 frames
DEGLITCH_CHANNEL=DCS-CALIB_STRAIN_CLEAN_SUB60HZ_C01_BW_DEGLITCHED
