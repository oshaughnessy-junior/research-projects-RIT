# GW250114_082203 -- paper-2 real-data glitch-marg demonstration (config U/MF/MP).
# Single source of truth: sourced by fetch_data.sh / build_basis.sh and parsed by
# ../common/make_event_ini.py.  Dossier: T7c report + bilby-antiglitch arXiv:2606.31304.
#
# Glitch character (arXiv:2606.31304): NO strong non-Gaussian artifact -- a weak low-frequency
# excess-power / small-vibration feature in L1.  This event is the LOUDEST (netSNR 78.6) and the
# antiglitch head-to-head; its paper-2 job is robustness (marginalization must not distort a
# clean loud event) and it REUSES the paper-1 (g4_poc) blip infrastructure.  We therefore attach
# a real L1-O3a Blip basis re-colored to the GW250114 L1 PSD near merger (see build_basis.sh).

TAG=GW250114
GPS=1420878141.2                 # geocenter merger GPS (GW250114_082203-v2)
IFOS=H1,L1
SRATE=2048
ILE_SEGLEN=8                     # analysis segment (N=2^14); PSD df=0.125 Hz
FRAME_SEGLEN=16                  # analysis frame length
FMIN=20
FMAX=1000
FREF=20
APPROX=IMRPhenomXPHM
LMAX=4
DMAX=3000
ASSUME_NOSPIN=False
DATA_TUKEY_WINDOW_TIME=0.4       # -> window_shape 0.1 for 8 s (T7c production convention)

# fiducial source point for the coinc (detector frame; Mc 31.3 / Mtot 71.9 / eta 0.25)
M1_DET=35.95
M2_DET=35.95
NET_SNR=78.6

# ---- glitch basis (Blip class, L1; reuse the g4_poc real-blip corpus/PCA, re-colored) ----
GLITCH_IFO=L1
GLITCH_CLASS=Blip
GLITCH_CENTER_GPS=1420878141.2   # basis support centred at the L1 merger region
GLITCH_FLO=25
GLITCH_FHI=1000
GLITCH_NOUT=1024                 # 0.5 s strain support at 2048 Hz
GLITCH_PCA_NWIN=64               # 31 ms central PCA window (glitschen r=6 blip rank)

# corpus: REUSE the paper-1 real L1 O3a Blip products (skips the 142 MB CSV + GWOSC fetch).
# To rebuild from scratch instead, unset these two and set CORPUS_CATALOG=<L1_O3a.csv>.
CORPUS_REUSE_CORPUS=~/rift_td/analyses/g4_poc/work/blip_corpus.npz
CORPUS_REUSE_PCA=~/rift_td/analyses/g4_poc/work/blip_pca_white.npz
CORPUS_CATALOG=
CORPUS_NTARGET=45
CORPUS_WINDOW_HALF=0.125
CORPUS_SNR_LO=12
CORPUS_SNR_HI=60
CORPUS_PEAKF_LO=100
CORPUS_PEAKF_HI=450
CORPUS_DURATION_MAX=0.5
CORPUS_MINPERWIN=3

# ---- paper-2 Sec. 3.2 detection-conditioned prior (MP config only) ----
# GLITCH_PRIOR_MODE: coefficient prior for the population (MP) run.  'signmix' = the exact
# two-component sign mixture (the operating recommendation for triggered events; needs the
# pop npz mu_mix/sigma_central keys); 'm2' = the cheap zero-mean moment-matched stand-in;
# 'pinned' = decisive-sign limit (only if the logged sign odds are decisive).
GLITCH_PRIOR_MODE=signmix
# GLITCH_SIGMA_MIN [strain]: presence-conditioning floor on sigma_g (a DETECTED glitch means
# sigma_g is not small -- raises the amplitude profile lower bound).  Empty = code default
# bounds.  GW250114 is a weak-glitch robustness case, so we leave it at the default; set e.g.
# 1e-21 for an event with a confidently-present loud glitch.
GLITCH_SIGMA_MIN=

# ---- D config: NOT available for GW250114 (no public deglitched frames; weak glitch). ----
DEGLITCH_CACHE=
