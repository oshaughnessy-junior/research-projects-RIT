# GW191109_010717 -- paper-2 real-data glitch-marg demonstration (config U/MF/MP/D).
# Dossier (arXiv:2409.03912 "anti-aligned spin of GW191109"; GWTC-3): slow SCATTERED-LIGHT
# glitches in BOTH L1 and H1 overlapping the inspiral; L1 ~35-40 Hz, ~0.1-0.04 s pre-merger.
# The spin/precession claim is data-quality sensitive -> the GPBilby head-to-head + spin target.
# Public deglitched frames exist (Zenodo 5546679) -> D config available.
#
# Detector-frame masses from source-frame x (1+z), z~=0.25: Mc~59, Mtot~140, eta~0.24
# (m1~84, m2~56 detector frame; fiducial coinc point only).  netSNR ~17.3.

TAG=GW191109
GPS=1257296855.2
IFOS=H1,L1
SRATE=2048
ILE_SEGLEN=8
FRAME_SEGLEN=16
FMIN=20                          # do NOT raise f_low: the point is to marginalize, not excise
FMAX=1000
FREF=20
APPROX=IMRPhenomXPHM
LMAX=4
DMAX=10000
ASSUME_NOSPIN=False
DATA_TUKEY_WINDOW_TIME=0.4
M1_DET=84.0
M2_DET=56.0
NET_SNR=17.3

# ---- glitch basis: SCATTERED_LIGHT (long arches), L1 (primary; H1 also affected) ----
GLITCH_IFO=L1
GLITCH_CLASS=Scattered_Light
GLITCH_CENTER_GPS=1257296855.13  # ~0.07 s pre-merger (glitch overlaps inspiral)
GLITCH_FLO=15
GLITCH_FHI=60
GLITCH_NOUT=8192                 # 4 s strain support at 2048 Hz (scattering is ~2-2.5 s)
GLITCH_PCA_NWIN=2048             # 1 s central PCA window

# corpus: fetch fresh Scattered_Light from Gravity Spy L1 O3b (Zenodo 5649212; ~216 MB CSV).
# GW191109 is O3b; L1_O3b.csv is the temporally-nearest scattering morphology.
CORPUS_REUSE_CORPUS=
CORPUS_REUSE_PCA=
CORPUS_CATALOG=L1_O3b.csv        # download: zenodo.org/records/5649212/files/L1_O3b.csv?download=1
CORPUS_NTARGET=60
CORPUS_WINDOW_HALF=1.5
CORPUS_SNR_LO=8
CORPUS_SNR_HI=100
CORPUS_PEAKF_LO=10
CORPUS_PEAKF_HI=60
CORPUS_DURATION_MAX=6
CORPUS_MINPERWIN=5

# ---- D config: PUBLIC BayesWave-deglitched frames (GWTC-3 glitch-modelling release) ----
# Download from Zenodo 5546679; set the local cache + channel of the *_BW_DEGLITCHED_* frames.
DEGLITCH_SOURCE=Zenodo 5546679 (GWTC-3 de-glitched frames)
DEGLITCH_CACHE=                  # set to the local file:// cache of the downloaded deglitched frames
DEGLITCH_CHANNEL=DCS-CALIB_STRAIN_CLEAN_SUB60HZ_C01_BW_DEGLITCHED
